# Data source used by the app.
#   local  – IndexedDB in the browser (default; used by the public demo)
#   remote – a backend adapter (not implemented in v1; see docs/DECISIONS.md)
VITE_DATA_SOURCE=local

# Demo workspace (optional; docs/DECISIONS.md D34). The demo lives outside this
# repository; without a URL the "Load demo" button is hidden and the app starts empty.
#   VITE_DEMO_URL         – URL of a workspace snapshot (format "translator-tool-workspace")
#   VITE_DEMO_IMAGES_URL  – link to real scene images people can upload themselves
VITE_DEMO_URL=
VITE_DEMO_IMAGES_URL=
